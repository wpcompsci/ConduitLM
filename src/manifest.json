{
  "manifest_version": 3,
  "name": "ConduitLM",
  "version": "0.0.0",
  "description": "ConduitLM Firefox MV3 WebExtension",
  "browser_specific_settings": {
    "gecko": {
      "id": "conduitlm@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://notebooklm.google.com/*"
  ],
  "action": {
    "default_title": "ConduitLM",
    "default_popup": "ui/popup/popup.html"
  },
  "background": {
    "scripts": [
      "background/main.js"
    ],
    "type": "module"
  }
}
{
  "manifest_version": 3,
  "name": "ConduitLM",
  "version": "0.0.0",
  "description": "ConduitLM Firefox MV3 WebExtension",
  "browser_specific_settings": {
    "gecko": {
      "id": "conduitlm@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "menus"
  ],
  "optional_host_permissions": [
    "https://notebooklm.google.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://docs.google.com/document/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "ConduitLM",
    "default_popup": "ui/popup/popup.html"
  },
  "background": {
    "scripts": [
      "lib/jszip.min.js",
      "lib/jspdf.umd.min.js",
      "utils/formatters.js",
      "utils/pdf-generator.js",
      "shared/errors.js",
      "shared/hosts.js",
      "shared/normalize.js",
      "shared/triggers.js",
      "shared/trigger_store.js",
      "sources/registry.js",
      "sources/chatgpt.js",
      "sources/gemini.js",
      "sources/gdocs.js",
      "sources/youtube.js",
      "sources/web.js",
      "integrations/notebooklm/rpc.js",
      "integrations/notebooklm/tokens.js",
      "integrations/notebooklm/batchexecute.js",
      "integrations/notebooklm/parse.js",
      "integrations/notebooklm/client.js",
      "ingestion/jobs.js",
      "ingestion/extractor.js",
      "ingestion/pipeline.js",
      "background/trigger_flow.js",
      "ui/contextMenus.js",
      "background/router.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/hosts.js",
        "shared/triggers.js",
        "content/inpage_ui.js",
        "content/loader_chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/hosts.js",
        "shared/triggers.js",
        "content/inpage_ui.js",
        "content/loader_gemini.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "shared/hosts.js",
        "shared/triggers.js",
        "content/inpage_ui.js",
        "content/loader_gdocs.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/hosts.js",
        "shared/triggers.js",
        "content/inpage_ui.js",
        "content/loader_youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "ConduitLM",
  "version": "0.0.0",
  "description": "ConduitLM Firefox MV3 WebExtension",
  "browser_specific_settings": {
    "gecko": {
      "id": "conduitlm@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://notebooklm.google.com/*"
  ],
  "action": {
    "default_title": "ConduitLM",
    "default_popup": "ui/popup/popup.html"
  },
  "background": {
    "scripts": [
      "lib/jszip.min.js",
      "lib/jspdf.umd.min.js",
      "utils/formatters.js",
      "utils/pdf-generator.js",
      "shared/errors.js",
      "shared/normalize.js",
      "sources/registry.js",
      "sources/chatgpt.js",
      "sources/gemini.js",
      "sources/gdocs.js",
      "sources/web.js",
      "integrations/notebooklm/rpc.js",
      "integrations/notebooklm/tokens.js",
      "integrations/notebooklm/batchexecute.js",
      "integrations/notebooklm/parse.js",
      "integrations/notebooklm/client.js",
      "ingestion/jobs.js",
      "ingestion/extractor.js",
      "ingestion/pipeline.js",
      "background/router.js"
    ]
  }
}

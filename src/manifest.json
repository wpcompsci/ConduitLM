{
  "manifest_version": 3,
  "name": "ConduitLM",
  "version": "1.0.0",
  "description": "Firefox MV3 Adapter for NotebookLM Ingestion",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "*://notebooklm.google.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://docs.google.com/*"
  ],
  "background": {
    "scripts": [
      "lib/jszip.min.js",
      "lib/jspdf.umd.min.js",
      "utils/formatters.js",
      "utils/pdf-generator.js",
      "integrations/notebooklm/rpc.js",
      "integrations/notebooklm/tokens.js",
      "integrations/notebooklm/parse.js",
      "integrations/notebooklm/client.js",
      "ingestion/pipeline.js",
      "background/router.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://docs.google.com/*"
      ],
      "js": [
        "ingestion/content_scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "ConduitLM"
  }
}
{
  "manifest_version": 3,
  "name": "ConduitLM",
  "version": "1.0.0",
  "description": "Firefox MV3 Adapter for NotebookLM Ingestion",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://notebooklm.google.com/*"
  ],
  "background": {
    "scripts": [
      "background/main.js"
    ]
  },
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "ConduitLM"
  }
}